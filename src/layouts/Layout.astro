---
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/public-sans/800.css';
import '../styles/global.css';
import { pathTo, absoluteUrl } from '../lib/paths';
import { Menu } from '@lucide/astro';
interface Props { title: string; description: string; page?: string }
const { title, description, page = '/' } = Astro.props;
const nav = [['Services', '/services/'], ['Who we help', '/who-we-help/'], ['About', '/about/'], ['FAQ', '/faq/']];
const canonical = absoluteUrl(page);
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'Marist Tech Clinic',
  description: 'A student-led team at Marist University providing technology assessments, training, planning and one-time projects for Hudson Valley organizations.',
  ...(absoluteUrl('/') ? { url: absoluteUrl('/') } : {}),
  areaServed: { '@type': 'Place', name: 'Hudson Valley, New York' },
  parentOrganization: { '@type': 'Organization', name: 'Marist Technology Research & Innovation Center' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#B31B1B" />
    <title>{title} | Marist Tech Clinic</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marist Tech Clinic" />
    <meta property="og:title" content={`${title} | Marist Tech Clinic`} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {absoluteUrl('/social-card.svg') && <meta property="og:image" content={absoluteUrl('/social-card.svg')} />}
    <meta property="og:image:alt" content="Marist Tech Clinic. Student-led technology help for the Hudson Valley." />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={pathTo('/favicon.svg')} />
    <script type="application/ld+json" set:html={JSON.stringify(org).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href={pathTo('/')} aria-label="Marist Tech Clinic home">Marist <span>Tech Clinic</span><small>Students helping our community.</small></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu <Menu size={18} aria-hidden="true" /></button>
        <nav id="site-nav" aria-label="Main navigation">
          {nav.map(([label, href]) => <a href={pathTo(href)} aria-current={page === href ? 'page' : undefined}>{label}</a>)}
          <a class="button button-small" href={pathTo('/request/')} aria-current={page === '/request/' ? 'page' : undefined}>Request a free assessment</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div><a class="wordmark" href={pathTo('/')}>Marist <span>Tech Clinic</span></a><p>Marist Tech Clinic · Marist Technology Research & Innovation Center · Poughkeepsie, NY</p><p class="small">Student-led program at Marist University.</p></div>
        <nav aria-label="Footer navigation">
          <a href={pathTo('/services/')}>Services</a><a href={pathTo('/who-we-help/')}>Who we help</a><a href={pathTo('/about/')}>About</a><a href={pathTo('/faq/')}>FAQ</a><a href={pathTo('/hudson-valley/')}>Hudson Valley</a><a href={pathTo('/contact/')}>Contact</a><a href={pathTo('/request/')}>Request an assessment</a>
        </nav>
        <div class="footer-contact"><h2>Let’s start a conversation.</h2><a class="text-link" href={pathTo('/contact/')}>Send us a message</a><p class="small">Official email and phone will be added here when available.</p></div>
      </div>
      <div class="container footer-bottom"><span>Technology help, with people at the center.</span><span>Assessments by written agreement. No emergency support.</span></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');
      if (toggle && nav) {
        document.documentElement.classList.add('nav-ready');
        const close = () => { toggle.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); };
        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          toggle.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('is-open', open);
        });
        nav.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) close(); });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); }
        });
        document.addEventListener('click', (event) => { if (!(event.target as HTMLElement).closest('.header-inner')) close(); });
        window.matchMedia('(min-width: 1000px)').addEventListener('change', close);
      }
    </script>
  </body>
</html>
